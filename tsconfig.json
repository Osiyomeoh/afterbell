{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["research/**/*.ts", "pricing/**/*.ts", "solana/client/**/*.ts", "solana/scripts/**/*.ts", "solana/keeper/**/*.ts", "quoter/**/*.ts", "evm/client/**/*.ts", "evm/scripts/**/*.ts", "evm/keeper/**/*.ts", "agent/**/*.ts", "hedger/**/*.ts", "sdk/**/*.ts"]
}
