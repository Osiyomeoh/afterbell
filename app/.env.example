# Copy to .env.local and fill in. Never commit real values.

# Pyth Hermes API key (Pyth Core). Needed for the closing print and live session prices.
PYTH_API_KEY=

# The Solana vault's quoter keypair: either the path to the keypair file (local)...
QUOTER_SOLANA_KEY_FILE=
# ...or its contents, the JSON array of 64 numbers (hosting).
QUOTER_SOLANA_KEY=

# Solana RPC for the browser; defaults to devnet.
NEXT_PUBLIC_SOLANA_RPC=

# The devnet faucet: TestUSD's mint authority, which also pays the faucet's fees and SOL drips.
FAUCET_SOLANA_KEY_FILE=
FAUCET_SOLANA_KEY=
