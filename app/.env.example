# Copy to .env.local and fill in. Never commit real values.

# Pyth Hermes API key (Pyth Core). Needed for the closing print and live session prices.
PYTH_API_KEY=

# The Solana vault's quoter keypair: either the path to the keypair file (local)...
QUOTER_SOLANA_KEY_FILE=
# ...or its contents, the JSON array of 64 numbers (hosting).
QUOTER_SOLANA_KEY=

# Solana RPC for the browser; defaults to devnet. SOLANA_RPC overrides it on the server.
NEXT_PUBLIC_SOLANA_RPC=
SOLANA_RPC=
# Optional: a different Solana deployment record than solana/deployments/devnet.json (npm run solana:local's, say).
SOLANA_DEPLOYMENT_FILE=

# The devnet faucet: TestUSD's mint authority, which also pays the faucet's fees and SOL drips.
FAUCET_SOLANA_KEY_FILE=
FAUCET_SOLANA_KEY=

# Mainnet RPC for reading a wallet's TSLAx and TSLAon (the public one rate-limits).
MAINNET_RPC_URL=

# The Robinhood Chain vault's quoter private key (0x…), once that vault is deployed.
QUOTER_EVM_KEY=
# Optional: a different EVM deployment record than evm/deployments/robinhood.json (a local fork, say).
EVM_DEPLOYMENT_FILE=
